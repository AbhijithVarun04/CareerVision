rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /students/{uid} {
      // Profile doc: the owner can read it and create it once at signup.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow update, delete: if false;

      // Attempts and recommendations are written only by the Cloud Function
      // (Admin SDK, which bypasses these rules). The app may only read them.
      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /recommendations/{recId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }

        // REQ-7.1 / REQ-7.3: a saved comparison lists 2 or 3 recommendations
        // and must sit under one of the student's own existing attempts.
        match /comparisons/{comparisonId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && exists(/databases/$(database)/documents/students/$(uid)/attempts/$(attemptId))
            && request.resource.data.keys().hasOnly(['comparison_date', 'recommendation_ids'])
            && request.resource.data.recommendation_ids is list
            && request.resource.data.recommendation_ids.size() >= 2
            && request.resource.data.recommendation_ids.size() <= 3;
          allow delete: if false;
        }
      }
    }
  }
}